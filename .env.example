APP_NAME="Treis Adiutor"
APP_ENV=local
APP_KEY=                        # Generate using: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost        # Change for production
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Query Optimization
DB_SLOW_QUERY_TIME=100
DB_LOG_SLOW_QUERIES=true

# Local MySQL config
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Maya Payment Gateway
MAYA_ENVIRONMENT=sandbox
MAYA_CURRENCY=PHP
MAYA_SANDBOX_PUBLIC_KEY=
MAYA_SANDBOX_SECRET_KEY=

# Production Maya
MAYA_PRODUCTION_PUBLIC_KEY=
MAYA_PRODUCTION_SECRET_KEY=
MAYA_WEBHOOK_SECRET=

# reCAPTCHA
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERSION=v2
RECAPTCHA_THEME=light
RECAPTCHA_SIZE=normal
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_FAIL_OPEN=false

# Alternative URL (optional)
DATABASE_URL=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (Brevo SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_AUTH_ADDRESS="auth@example.com"
MAIL_AUTH_NAME="Treis Adiutor - Authentication"

MAIL_PROJECTS_ADDRESS="projects@example.com"
MAIL_PROJECTS_NAME="Treis Adiutor - Projects"

MAIL_SUPPORT_ADDRESS="support@example.com"
MAIL_SUPPORT_NAME="Treis Adiutor - Support"

MAIL_NOTIFICATIONS_ADDRESS="notifications@example.com"
MAIL_NOTIFICATIONS_NAME="Treis Adiutor - Notifications"

MAIL_BILLING_ADDRESS="billing@example.com"
MAIL_BILLING_NAME="Treis Adiutor - Billing"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

FIREBASE_FCM_SERVER_KEY=
FIREBASE_VAPID_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH auto handled by config

# Firebase Auth
FIREBASE_AUTH_ENABLED=true
FIREBASE_WEB_API_KEY=${FIREBASE_API_KEY}
FIREBASE_GOOGLE_ENABLED=true
FIREBASE_APPLE_ENABLED=false
FIREBASE_TWITTER_ENABLED=true
FIREBASE_AUTH_GOOGLE_ENABLED=true
FIREBASE_AUTH_TWITTER_ENABLED=true

# Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/calendar/callback

# Cloudflare R2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_ACCOUNT_ID=

# Brandfetch
BRANDFETCH_CLIENTID=